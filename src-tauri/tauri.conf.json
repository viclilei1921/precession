{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "precession",
  "version": "0.1.3",
  "identifier": "com.viclilei.precession",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "precession",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/ffmpeg", "binaries/cjxl", "binaries/avifenc", "binaries/ssimulacra2", "binaries/avifdec"],
    "resources": ["resources/vmaf/vmaf_v0.6.1.json"],
    "fileAssociations": [
      { "ext": ["png"], "name": "PNG", "description": "PNG image", "role": "Viewer", "mimeType": "image/png" },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG",
        "description": "JPEG image",
        "role": "Viewer",
        "mimeType": "image/jpeg"
      },
      { "ext": ["gif"], "name": "GIF", "description": "GIF image", "role": "Viewer", "mimeType": "image/gif" },
      { "ext": ["webp"], "name": "WebP", "description": "WebP image", "role": "Viewer", "mimeType": "image/webp" },
      { "ext": ["bmp"], "name": "BMP", "description": "BMP image", "role": "Viewer", "mimeType": "image/bmp" },
      { "ext": ["avif"], "name": "AVIF", "description": "AVIF image", "role": "Viewer", "mimeType": "image/avif" },
      { "ext": ["jxl"], "name": "JPEGXL", "description": "JPEG XL image", "role": "Viewer", "mimeType": "image/jxl" }
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
