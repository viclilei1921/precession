{
  "name": "precession",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:android": "tauri android dev --host 127.0.0.1",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg",
    "build:android": "tauri android build --target aarch64",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fmt": "cd src-tauri && cargo fmt --check",
    "fmt:fix": "cd src-tauri && cargo fmt",
    "format": "pnpm lint:fix && pnpm fmt:fix",
    "up:c": "pnpm outdated --long",
    "up:i": "pnpm up --latest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2.12.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
