{
  "name": "precession",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:android": "tauri android dev --host 127.0.0.1",
    "build:win": "tauri build --bundles nsis",
    "build:mac": "tauri build --bundles dmg",
    "build:android": "tauri android build --target aarch64",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fmt": "cd src-tauri && cargo fmt --check",
    "fmt:fix": "cd src-tauri && cargo fmt",
    "format": "pnpm lint:fix && pnpm fmt:fix",
    "up:c": "pnpm outdated --long",
    "up:i": "pnpm up --latest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "~2.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
